# ==============================================================================
# MediVoice AI - Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# AI Service Provider Selection
# Options:
#   'local'  - Zero-credential, rule-based deterministic heuristic engine (Default & recommended for local dev/hackathon)
#   'gemini' - Google Gemini Generative AI API
#   'openai' - OpenAI Chat Completion API
AI_PROVIDER=local

# External AI Credentials (Optional - NOT required for core triage & voice features)
# Keep empty if using AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Operational Environment
NODE_ENV=development
